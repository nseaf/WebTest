{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/.git/**",
      "**/.tmp/**",
      "**/result/**"
    ]
  },
  "default_agent": "Coordinator",
  "agent": {
    "Coordinator": {
      "description": "Coordinator: workflow orchestration and cross-agent coordination.",
      "mode": "primary",
      "temperature": 0.2,
      "prompt": "{file:.opencode/agents/coordinator.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true
      },
      "permission": {
        "task": {
          "navigator": "allow",
          "form": "allow",
          "security": "allow",
          "analyzer": "allow",
          "account_parser": "allow",
          "*": "allow"
        },
        "bash": {
          "*": "ask",
          "browser-use *": "allow",
          ".\\scripts\\browser-use-utf8.ps1 *": "allow",
          "scripts/browser-use-utf8.ps1 *": "allow",
          ".\\scripts\\start-managed-chrome.ps1 *": "allow",
          "scripts/start-managed-chrome.ps1 *": "allow",
          "docker *": "allow",
          "curl *": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "navigator": {
      "description": "Navigator Agent: managed Chrome, login, recovery, exploration, and cookie sync.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/navigator.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "browser-use *": "allow",
          ".\\scripts\\browser-use-utf8.ps1 *": "allow",
          "scripts/browser-use-utf8.ps1 *": "allow",
          ".\\scripts\\start-managed-chrome.ps1 *": "allow",
          "scripts/start-managed-chrome.ps1 *": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "form": {
      "description": "Form Agent: complex business forms and multi-step submissions.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/form.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "browser-use *": "allow",
          ".\\scripts\\browser-use-utf8.ps1 *": "allow",
          "scripts/browser-use-utf8.ps1 *": "allow",
          ".\\scripts\\start-managed-chrome.ps1 *": "allow",
          "scripts/start-managed-chrome.ps1 *": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "security": {
      "description": "Security Agent: replay testing, auth-stale handling, and CSRF retry recovery.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/security.md}",
      "tools": {
        "write": true,
        "edit": false,
        "bash": true,
        "skill": true
      },
      "permission": {
        "task": {
          "analyzer": "allow"
        },
        "bash": {
          "*": "ask",
          "docker *": "allow",
          "curl *": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "analyzer": {
      "description": "Analyzer Agent: stable replay analysis, vulnerability judgment, and severity rating.",
      "mode": "subagent",
      "temperature": 0.15,
      "prompt": "{file:.opencode/agents/analyzer.md}",
      "tools": {
        "write": true,
        "edit": false,
        "bash": false,
        "skill": true
      },
      "permission": {
        "skill": {
          "*": "allow"
        }
      }
    },
    "account_parser": {
      "description": "Account Parser: account document parsing and accounts.json generation.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:.opencode/agents/account_parser.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "skill": true
      },
      "permission": {
        "bash": {
          "*": "ask"
        },
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "skill": {
      "*": "allow"
    }
  }
}
